#version 450
layout(local_size_x = 64) in;
layout(constant_id = 0) const int SEED = 1;
layout(constant_id = 1) const int ROUNDS = 4;
layout(std430, binding = 0) buffer B { float v[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    float a = v[i] + float(SEED);
    for (int r = 0; r < ROUNDS; r++) {
        for (int k = 0; k < 24; k++) {
            a = sin(a * 1.0001 + float(k)) * cos(a - float(SEED + k)) + sqrt(abs(a) + 1.0);
            if (a > float(SEED % 13)) a = fract(a) * exp(-a * 0.01); else a = a * a - log(abs(a) + 2.0);
        }
        v[(i + uint(r)) % 1024u] += a;
    }
    v[i] = a;
}
