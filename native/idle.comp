#version 450
layout(local_size_x = 64) in;
layout(push_constant) uniform P { int frame; int iters; } pc;
layout(std430, binding = 0) buffer B { int v[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    float a = float(i) * 0.001;
    for (int k = 0; k < pc.iters; k++) a = sin(a * 1.37 + float(k)) * 0.9 + cos(a) * 0.1;
    v[i] = (a == 12345.678) ? -1 : pc.frame * 1000 + int(i % 1000u);
}
